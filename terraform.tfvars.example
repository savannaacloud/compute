prefix              = "compute-demo"
region              = "ng-abuja-1"
instance_plan       = "m1.small"
image_name          = "Ubuntu 22.04 LTS"

# Network is looked up by name (defaults to "default" / "public"; uncomment to override):
# network_name          = "default"
# external_network_name = "public"


# Optional toggles (k8s adds ~10 min to apply time)
enable_kubernetes      = false
enable_kafka           = true
kubernetes_node_count  = 2
